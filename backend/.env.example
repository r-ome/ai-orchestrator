# Copy to backend/.env. `app/env.py` reads it at startup.
# A real environment variable always wins over a line here.

# --- Planning session roles -------------------------------------------------
# Clarifier and planner: Claude, Opus 5. They share one model knob.
PLANNING_CLARIFIER_PROVIDER=claude
PLANNING_PLANNER_PROVIDER=claude
PLANNING_CLAUDE_MODEL=claude-opus-5

# Reviewer: Codex, GPT-5.6 Sol, high reasoning effort.
PLANNING_REVIEWER_PROVIDER=codex
PLANNING_CODEX_MODEL=gpt-5.6-sol
PLANNING_CODEX_REASONING_EFFORT=high

# --- Implementation ---------------------------------------------------------
# Work items run on Codex unless the run or the item overrides the provider.
# Complexity still picks the model: luna / terra / sol.
ROUTING_DEFAULT_PROVIDER=codex
ROUTING_CODEX_LOW_MODEL=gpt-5.6-luna
ROUTING_CODEX_MEDIUM_MODEL=gpt-5.6-terra
ROUTING_CODEX_HIGH_MODEL=gpt-5.6-sol

# --- Unchanged, listed so the full picture is in one file -------------------
# The delegator that splits the plan into work items.
DELEGATOR_MODEL=claude-sonnet-5
# The integration reviewer that checks the merged result.
INTEGRATION_REVIEW_MODEL=claude-sonnet-5

# How long the unattended driver may keep starting work items. It stops on its
# own when the graph drains; this is the ceiling for the case where it does
# not. Checked between items, so a run in flight is never cut off mid-turn.
DELEGATION_DRIVER_MAX_SECONDS=7200
